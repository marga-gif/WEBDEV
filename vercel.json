{
  "cleanUrls": true,
  "builds": [
    { "src": "html/**/*.html", "use": "@vercel/static" },
    { "src": "css/**/*.css", "use": "@vercel/static" },
    { "src": "images/**/*", "use": "@vercel/static" },
    { "src": "backend/**/*", "use": "@vercel/static" },
    { "src": "admin/**/*", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/html/index.html" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/backend/(.*)", "destination": "/backend/$1" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/(Aboutus|finance|gov|index|login|Medical|register|Socialwellness)", "destination": "/html/$1.html" }
  ]
}